+// sendMediaRemoteCommand на канал событий аудио-соединения (обсуждение #2262).
+static void send_remote_command(const char *name) {
+#ifdef CONFIG_AIRPLAY_2
+  rtsp_conn_info *conn = get_active_ap2_event_connection();
+  if (conn != NULL && conn->event_channel_fd > 0 &&
+      conn->airplay_stream_category != remote_control_stream) {
+    int number = -1;
+    if (!strcmp(name, "play"))
+      number = 0;
+    else if (!strcmp(name, "pause"))
+      number = 1;
+    else if (!strcmp(name, "playpause"))
+      number = 2;
+    else if (!strcmp(name, "stop"))
+      number = 3;
+    else if (!strcmp(name, "nextitem"))
+      number = 4;
+    else if (!strcmp(name, "previtem"))
+      number = 5;
+    if (number >= 0) {
+      ap2_event_send_modern_media_remote_command(conn, number);
+      return;
+    }
+  }
+#endif
 #ifdef CONFIG_DACP_CLIENT
-  send_simple_dacp_command("nextitem");
+  send_simple_dacp_command(name);
 #endif
+}
